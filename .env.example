SECRET_KEY=change-this-local-secret
DJANGO_DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

DB_USER=postgres
DB_PASSWORD=postgres_local_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ffactory

# Optional: use this instead of the DB_* variables when deploying.
# DATABASE_URL=postgresql://postgres:postgres_local_password@localhost:5432/ffactory

# Use true only when the app runs with HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=Lax

# Login hardening.
LOGIN_ATTEMPT_LIMIT=5
LOGIN_LOCK_SECONDS=300

# Deployment/security toggles.
DB_CONN_MAX_AGE=60
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SECURE_REFERRER_POLICY=same-origin
